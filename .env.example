# Model backend:
#   codex  - uses the local `codex` CLI and your ChatGPT subscription (run `codex login` once)
#   openai - uses the OpenAI API; needs a separately billed API key from platform.openai.com
AGENT_BACKEND=codex

# Optional: model name (empty = backend default)
AGENT_MODEL=

# Only for AGENT_BACKEND=openai
OPENAI_API_KEY=

AGENT_MAX_STEPS=10
AGENT_AUDIT_LOG=logs/audit.jsonl
AGENT_REQUEST_TIMEOUT_SECONDS=120
AGENT_MAX_TOOL_RESULT_CHARS=8000
